  classDef state fill:#e2e8f0,stroke:#475569,color:#0f172a

  class NL,Voice,Cmd,GUI,Auto user
  class Input,DefaultUI,Canvas,ConfirmUI,AuditUI ui
  class Context,CapGraph,Components,Tokens,DataSources,Schemas,Prompt,Gateway,Planner,PlanValidator,IntentPlan brain
  class UIDSL,DSLValidator,Interpreter,VirtualTree,Factory,Layout gen
  class ActionRouter,Policy,Permission,DataEngine,Executor,SystemAPI,Journal safe
  class StateKernel,StateBus,Events state
