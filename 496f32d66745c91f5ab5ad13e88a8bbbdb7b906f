tart;\n+        justify-content: space-between;\n+        gap: 18px;\n+      }\n+\n+      h1 {\n+        margin: 0;\n+        font-size: 34px;\n+        line-height: 1.08;\n+        letter-spacing: 0.01em;\n+      }\n+\n+      .subtitle {\n+        max-width: 960px;\n+        margin-top: 10px;\n+        color: var(--muted);\n+        font-size: 15px;\n+        line-height: 1.72;\n+      }\n+\n+      .badges {\n+        display: flex;\n+        flex-wrap: wrap;\n+        gap: 10px;\n+        justify-content: flex-end;\n+      }\n+\n+      .badge {\n+        padding: 8px 12px;\n+        border-radius: 999px;\n+        font-size: 13px;\n+        font-weight: 700;\n+        color: #34526c;\n+        background: #edf4f9;\n+        border: 1px solid #d4e2ee;\n+      }\n+\n+      .quote {\n+        padding: 16px 18px;\n+        border-radius: 18px;\n+        background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(240, 245, 249, 0.94) 100%);\n+        border: 1px solid #d9e5ef;\n+        color: #35536d;\n+        font-size: 18px;\n+        line-height: 1.7;\n+        font-weight: 600;\n+      }\n+\n+      .callouts {\n+        display: grid;\n+        grid-template-columns: repeat(3, minmax(0, 1fr));\n+        gap: 12px;\n+      }\n+\n+      .callout {\n+        padding: 14px 16px;\n+        border-radius: 18px;\n+        border: 1px solid #d7e4ee;\n+        background: rgba(255, 255, 255, 0.9);\n+      }\n+\n+      .callout h3 {\n+        margin: 0 0 8px;\n+        font-size: 15px;\n+      }\n+\n+      .callout p {\n+        margin: 0;\n+        color: var(--muted);\n+        font-size: 13px;\n+        line-height: 1.65;\n+      }\n+\n+      .grid {\n+        display: grid;\n+        grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.85fr);\n+        gap: 16px;\n+      }\n+\n+      .panel {\n+        padding: 18px;\n+      }\n+\n+      .section-title {\n+        margin: 0 0 14px;\n+        font-size: 19px;\n+        font-weight: 800;\n+      }\n+\n+   