# Copy to .env.local and fill one generation provider key.
# .env.local is ignored by git.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 桌面开发进程使用；当前测试代理默认可用 gpt-5.4-mini。
VITE_LITEASY_OPENAI_MODEL=gpt-5.4-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LITEASY_MODEL_PROVIDER=openai

# Deployment-owned scholarly search credentials. Desktop users never configure these values.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# Optional recommendation semantic reranking. All three values are required.
# Candidate titles, abstracts, authors, selected paper titles, and enabled research-profile
# queries are sent to this explicitly configured OpenAI-compatible /embeddings endpoint.
LITEASY_RECOMMENDATION_EMBEDDING_API_KEY=
LITEASY_RECOMMENDATION_EMBEDDING_BASE_URL=
LITEASY_RECOMMENDATION_EMBEDDING_MODEL=

# Optional second-stage recommendation reranker. All three values are required.
# The selected-paper/profile query and at most 8 quality-gated candidate titles,
# abstracts, and up to 6 authors are sent to this Cohere-compatible /rerank endpoint.
LITEASY_RECOMMENDATION_RERANKER_API_KEY=
LITEASY_RECOMMENDATION_RERANKER_BASE_URL=
LITEASY_RECOMMENDATION_RERANKER_MODEL=
