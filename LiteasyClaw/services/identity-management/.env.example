NODE_ENV=production
IDENTITY_MANAGEMENT_HOST=127.0.0.1
IDENTITY_MANAGEMENT_PORT=9090

# OIDC client used by Liteasy Cloud to call this adapter.
IDENTITY_MANAGEMENT_ISSUER=https://identity.example.com/realms/liteasy
IDENTITY_MANAGEMENT_INTROSPECTION_URL=https://identity.example.com/realms/liteasy/protocol/openid-connect/token/introspect
IDENTITY_MANAGEMENT_CALLER_CLIENT_ID=liteasy-account-lifecycle
IDENTITY_MANAGEMENT_AUDIENCE=liteasy-identity-management

# Separate confidential client used only for RFC 7662 introspection.
IDENTITY_MANAGEMENT_INTROSPECTION_CLIENT_ID=liteasy-identity-introspection
IDENTITY_MANAGEMENT_INTROSPECTION_CLIENT_SECRET=replace-with-deployment-secret

# Separate least-privilege client used only by this adapter to call Keycloak.
IDENTITY_MANAGEMENT_ADMIN_TOKEN_URL=https://identity.example.com/realms/liteasy/protocol/openid-connect/token
IDENTITY_MANAGEMENT_ADMIN_API_URL=https://identity.example.com/admin/realms/liteasy
IDENTITY_MANAGEMENT_ADMIN_CLIENT_ID=liteasy-keycloak-admin
IDENTITY_MANAGEMENT_ADMIN_CLIENT_SECRET=replace-with-deployment-secret
