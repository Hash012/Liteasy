[Unit]
Description=Liteasy marketing application and download service
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/liteasy/waitlist
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
EnvironmentFile=-/opt/liteasy/waitlist/.env
Environment=WAITLIST_HOST=172.20.0.1
Environment=WAITLIST_PORT=8787
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/liteasy/waitlist

[Install]
WantedBy=multi-user.target
