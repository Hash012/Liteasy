[Unit]
Description=Liteasy marketing application and download service
After=network.target

[Service]
WorkingDirectory=/opt/liteasy/waitlist
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
RuntimeDirectory=liteasy-waitlist
RuntimeDirectoryMode=0755
Environment=WAITLIST_SOCKET_PATH=/run/liteasy-waitlist/waitlist.sock
EnvironmentFile=-/opt/liteasy/waitlist/.env
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/liteasy/waitlist /run/liteasy-waitlist

[Install]
WantedBy=multi-user.target
