KC_DB=postgres
KC_DB_URL=jdbc:postgresql://replace-with-rds-internal-host:5432/keycloak?sslmode=verify-full&sslrootcert=/run/certs/aliyun-rds-ca.pem
KC_DB_SCHEMA=public
KC_DB_USERNAME=keycloak_app
KC_DB_PASSWORD=replace-with-root-only-database-password
KC_CACHE=local
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HTTP_ENABLED=true
KC_HOSTNAME=https://auth.staging.liteasyclaw.com
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
KC_PROXY_HEADERS=xforwarded
KC_BOOTSTRAP_ADMIN_USERNAME=replace-with-staging-infrastructure-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-independent-root-only-secret
JAVA_OPTS_KC_HEAP=-Xms256m -Xmx768m

LITEASY_DESKTOP_LOOPBACK_REDIRECT_URI=http://127.0.0.1:*/*
LITEASY_DESKTOP_LOCALHOST_REDIRECT_URI=http://localhost:*/*
LITEASY_DESKTOP_WEB_ORIGIN=http://tauri.localhost
INTUECHO_WEB_REDIRECT_URI=https://community.staging.liteasyclaw.com/*
INTUECHO_WEB_ORIGIN=https://community.staging.liteasyclaw.com
LITEASY_ADMIN_REDIRECT_URI=https://admin.staging.liteasyclaw.com/*
LITEASY_ADMIN_WEB_ORIGIN=https://admin.staging.liteasyclaw.com

LITEASY_CLOUD_CLIENT_SECRET=replace-with-independent-root-only-secret
INTUECHO_API_CLIENT_SECRET=replace-with-independent-root-only-secret
LITEASY_IDENTITY_MANAGEMENT_CLIENT_SECRET=replace-with-independent-root-only-secret
LITEASY_IDENTITY_INTROSPECTION_CLIENT_SECRET=replace-with-independent-root-only-secret
LITEASY_IDENTITY_ADMIN_CLIENT_SECRET=replace-with-independent-root-only-secret
INTUECHO_ORGANIZATION_SERVICE_SECRET=replace-with-independent-root-only-secret
LITEASY_VISUALIZATION_SERVICE_CLIENT_SECRET=replace-with-independent-root-only-secret
LITEASY_LITERATURE_SERVICE_CLIENT_SECRET=replace-with-independent-root-only-secret
