NODE_ENV=staging
LITEASY_CLOUD_HOST=0.0.0.0
LITEASY_CLOUD_PORT=8787
LITEASY_ALLOWED_ORIGINS=http://tauri.localhost,https://admin.staging.liteasyclaw.com

DATABASE_URL=postgresql://liteasy_app:replace-with-url-safe-database-password@replace-with-rds-internal-host:5432/liteasy
LITEASY_MIGRATION_DATABASE_URL=postgresql://liteasy_migrator:replace-with-url-safe-database-password@replace-with-rds-internal-host:5432/liteasy
LITEASY_MARKETING_APPLICATION_SECRET=replace-with-a-random-server-secret
LITEASY_DATABASE_SSL_MODE=verify-full

LITEASY_S3_REGION=cn-hongkong
LITEASY_S3_BUCKET=replace-with-unique-private-staging-bucket
LITEASY_S3_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
LITEASY_S3_FORCE_PATH_STYLE=false
LITEASY_S3_PREFIX=documents
LITEASY_S3_SECURITY_PROFILE=aliyun-oss
AWS_ACCESS_KEY_ID=replace-with-staging-ram-access-key
AWS_SECRET_ACCESS_KEY=replace-with-oss-ram-access-key-secret
AWS_SESSION_TOKEN=

LITEASY_PDF_SCANNER_URL=https://replace-with-private-pdf-scanner.example
LITEASY_PDF_SCANNER_SECRET=replace-with-root-only-secret-at-least-32-characters
LITEASY_PDF_SCANNER_TIMEOUT_MS=120000

LITEASY_IDP_ISSUER=https://auth.staging.liteasyclaw.com/realms/liteasy
LITEASY_IDP_DISCOVERY_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/.well-known/openid-configuration
LITEASY_IDP_JWKS_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/protocol/openid-connect/certs
LITEASY_IDP_INTROSPECTION_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/protocol/openid-connect/token/introspect
LITEASY_IDP_REVOCATION_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/protocol/openid-connect/revoke
LITEASY_IDP_TOKEN_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/protocol/openid-connect/token
LITEASY_IDP_CLIENT_ID=liteasy-cloud
LITEASY_IDP_CLIENT_SECRET=replace-with-same-root-only-secret-as-keycloak
LITEASY_IDP_DESKTOP_CLIENT_ID=liteasy-desktop-public
LITEASY_IDP_ADMIN_CLIENT_ID=liteasy-admin-public
LITEASY_IDP_INTUECHO_SERVICE_CLIENT_ID=intuecho-organization-service
LITEASY_IDP_LITERATURE_SERVICE_CLIENT_ID=liteasy-literature-projection-service
LITEASY_IDP_LITERATURE_SERVICE_CLIENT_SECRET=replace-with-same-root-only-secret-as-keycloak
LITEASY_IDP_MANAGEMENT_CLIENT_ID=liteasy-account-lifecycle
LITEASY_IDP_MANAGEMENT_CLIENT_SECRET=replace-with-same-root-only-secret-as-keycloak
LITEASY_IDP_MANAGEMENT_URL=https://identity.staging.liteasyclaw.com
LITEASY_IDP_VISUALIZATION_SERVICE_CLIENT_ID=liteasy-visualization-service

LITEASY_INTUECHO_ADMIN_API_URL=https://community.staging.liteasyclaw.com
LITEASY_INTUECHO_LITERATURE_API_URL=https://community.staging.liteasyclaw.com

LITEASY_RECOMMENDATION_CONTACT_EMAIL=replace-with-monitored-research-contact@example.invalid
LITEASY_RECOMMENDATION_CROSSREF_ENDPOINT=https://api.crossref.org/works
LITEASY_RECOMMENDATION_TIMEOUT_MS=10000
LITEASY_RETRIEVAL_CONTACT_EMAIL=replace-with-monitored-research-contact@example.invalid
LITEASY_RETRIEVAL_TIMEOUT_MS=15000
LITEASY_RETRIEVAL_MAX_PDF_BYTES=33554432
LITEASY_RETRIEVAL_SEMANTIC_SCHOLAR_API_KEY=

# Add one or both provider groups only after the staging budget and key owner are approved.
# LITEASY_MODEL_OPENAI_API_KEY=replace-with-provider-api-key
# LITEASY_MODEL_OPENAI_BASE_URL=https://api.openai.com/v1
# LITEASY_MODEL_OPENAI_MODEL=replace-with-approved-model
# LITEASY_MODEL_DEEPSEEK_API_KEY=replace-with-provider-api-key
# LITEASY_MODEL_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LITEASY_MODEL_DEEPSEEK_MODEL=deepseek-chat
LITEASY_MODEL_TIMEOUT_MS=300000
# Deploy GROBID on a separate memory-capable node and expose it only through private HTTPS.
LITEASY_GROBID_ENDPOINT=https://grobid.staging.internal
LITEASY_GROBID_MAX_PDF_BYTES=33554432
LITEASY_GROBID_TIMEOUT_MS=180000
# LITEASY_MINERU_TOKEN=replace-with-mineru-api-token
LITEASY_MINERU_MAXIMUM_CONCURRENCY=2
LITEASY_MINERU_TIMEOUT_MS=600000
# Required before administrators can save encrypted AI provider credentials.
# Generate once with: openssl rand -base64 32
# LITEASY_PLATFORM_CONFIG_ENCRYPTION_KEY=replace-with-base64-32-byte-key

LITEASY_VISUALIZATION_EGRESS_HOSTNAMES=api.deepseek.com,vip.auto-code.net
LITEASY_VISUALIZATION_SECRETS_JSON={}
