NODE_ENV=staging
INTUECHO_API_HOST=0.0.0.0
INTUECHO_API_PORT=4040
INTUECHO_ALLOWED_ORIGINS=https://community.staging.liteasyclaw.com,https://admin.staging.liteasyclaw.com,http://tauri.localhost

INTUECHO_DATABASE_URL=postgresql://intuecho_app:replace-with-url-encoded-kms-secret@replace-with-rds-internal-host:5432/intuecho
INTUECHO_MIGRATION_DATABASE_URL=postgresql://intuecho_migrator:replace-with-url-encoded-kms-secret@replace-with-rds-internal-host:5432/intuecho
INTUECHO_DATABASE_SSL_MODE=verify-full

INTUECHO_IDP_ISSUER=https://auth.staging.liteasyclaw.com/realms/liteasy
INTUECHO_IDP_DISCOVERY_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/.well-known/openid-configuration
INTUECHO_IDP_JWKS_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/protocol/openid-connect/certs
INTUECHO_IDP_INTROSPECTION_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/protocol/openid-connect/token/introspect
INTUECHO_IDP_TOKEN_URL=https://auth.staging.liteasyclaw.com/realms/liteasy/protocol/openid-connect/token
INTUECHO_IDP_CLIENT_ID=intuecho-api
INTUECHO_IDP_CLIENT_SECRET=replace-with-same-kms-secret-as-keycloak
INTUECHO_IDP_WEB_CLIENT_ID=intuecho-web

INTUECHO_ORGANIZATION_API_URL=https://api.staging.liteasyclaw.com
INTUECHO_ORGANIZATION_SERVICE_CLIENT_ID=intuecho-organization-service
INTUECHO_ORGANIZATION_SERVICE_CLIENT_SECRET=replace-with-same-kms-secret-as-keycloak
INTUECHO_LITEASY_LITERATURE_SERVICE_CLIENT_ID=liteasy-literature-projection-service
INTUECHO_ADMIN_API_URL=https://api.staging.liteasyclaw.com

INTUECHO_ARXIV_ENDPOINT=https://export.arxiv.org/api/query
INTUECHO_CROSSREF_ENDPOINT=https://api.crossref.org/works
INTUECHO_DBLP_RECORD_ENDPOINT=https://dblp.org/rec
INTUECHO_DBLP_SEARCH_ENDPOINT=https://dblp.org/search/publ/api
INTUECHO_OPENALEX_ENDPOINT=https://api.openalex.org/works
INTUECHO_OPENALEX_API_KEY=
INTUECHO_OPENREVIEW_ENDPOINT=https://api2.openreview.net/notes
INTUECHO_OPENREVIEW_SEARCH_ENDPOINT=https://api2.openreview.net/notes/search
INTUECHO_PMLR_ENDPOINT=https://proceedings.mlr.press
INTUECHO_SEMANTIC_SCHOLAR_ENDPOINT=https://api.semanticscholar.org/graph/v1/paper
INTUECHO_SEMANTIC_SCHOLAR_API_KEY=
