STAGING_RUNTIME_DIR=/etc/liteasy/staging
RDS_CA_CERT_FILE=/etc/liteasy/staging/aliyun-rds-ca.pem
GATEWAY_ENV_FILE=/etc/liteasy/staging/gateway.env
KEYCLOAK_ENV_FILE=/etc/liteasy/staging/keycloak.env
IDENTITY_MANAGEMENT_ENV_FILE=/etc/liteasy/staging/identity-management.env
LITEASY_API_ENV_FILE=/etc/liteasy/staging/liteasy-api.env
INTUECHO_API_ENV_FILE=/etc/liteasy/staging/intuecho-api.env

MARKETING_HOST=staging.liteasyclaw.com
COMMUNITY_HOST=community.staging.liteasyclaw.com
ADMIN_HOST=admin.staging.liteasyclaw.com
API_HOST=api.staging.liteasyclaw.com
AUTH_HOST=auth.staging.liteasyclaw.com
IDENTITY_HOST=identity.staging.liteasyclaw.com

# Replace every example reference with an ACR or upstream image pinned by digest.
GATEWAY_IMAGE=registry.cn-hongkong.aliyuncs.com/liteasy/staging-gateway@sha256:replace-with-reviewed-digest
LITEASY_API_IMAGE=registry.cn-hongkong.aliyuncs.com/liteasy/liteasy-api@sha256:replace-with-reviewed-digest
INTUECHO_API_IMAGE=registry.cn-hongkong.aliyuncs.com/liteasy/intuecho-api@sha256:replace-with-reviewed-digest
IDENTITY_MANAGEMENT_IMAGE=registry.cn-hongkong.aliyuncs.com/liteasy/identity-management@sha256:replace-with-reviewed-digest
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:98fab020a3a490aba0978f237e2a06cd0ea42bf149c6cf10f11c0aaf27728ff2
