{
  "realm": "liteasy",
  "enabled": true,
  "displayName": "Liteasy staging",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "verifyEmail": true,
  "browserFlow": "liteasy-user-browser",
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 31536000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 31536000,
  "authenticationFlows": [
    {
      "alias": "liteasy-user-browser",
      "description": "Desktop and community browser flow using SSO or password without OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "liteasy-user-forms"
        }
      ]
    },
    {
      "alias": "liteasy-user-forms",
      "description": "Password form for non-administrative clients",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "liteasy-admin-browser",
      "description": "Dedicated administrator flow requiring password and OTP on every login",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for stable subject and authentication time claims",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect profile claims required by Liteasy public clients",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect email claims required by Liteasy public clients",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "accounts:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "sessions:revoke",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "organization:authorize",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "visualization:generate",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "literature:verify",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ],
  "clients": [
    {
      "clientId": "liteasy-desktop-public",
      "name": "Liteasy Windows desktop staging",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "profile", "email"],
      "authenticationFlowBindingOverrides": { "browser": "liteasy-user-browser" },
      "redirectUris": [
        "${LITEASY_DESKTOP_LOOPBACK_REDIRECT_URI}",
        "${LITEASY_DESKTOP_LOCALHOST_REDIRECT_URI}"
      ],
      "webOrigins": ["${LITEASY_DESKTOP_WEB_ORIGIN}"],
      "attributes": {
        "client.offline.session.idle.timeout": "31536000",
        "client.offline.session.max.lifespan": "31536000",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${LITEASY_DESKTOP_LOOPBACK_REDIRECT_URI}##${LITEASY_DESKTOP_LOCALHOST_REDIRECT_URI}"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "liteasy-desktop-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "liteasy-desktop",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "intuecho-web",
      "name": "Intuecho Web staging",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "profile", "email"],
      "authenticationFlowBindingOverrides": { "browser": "liteasy-user-browser" },
      "redirectUris": ["${INTUECHO_WEB_REDIRECT_URI}"],
      "webOrigins": ["${INTUECHO_WEB_ORIGIN}"],
      "attributes": {
        "client.offline.session.idle.timeout": "2592000",
        "client.offline.session.max.lifespan": "2592000",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${INTUECHO_WEB_REDIRECT_URI}"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "intuecho-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "intuecho-web",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "liteasy-admin-public",
      "name": "Liteasy administration Web staging",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "profile", "email"],
      "authenticationFlowBindingOverrides": { "browser": "liteasy-admin-browser" },
      "redirectUris": ["${LITEASY_ADMIN_REDIRECT_URI}"],
      "webOrigins": ["${LITEASY_ADMIN_WEB_ORIGIN}"],
      "attributes": {
        "client.offline.session.idle.timeout": "2592000",
        "client.offline.session.max.lifespan": "2592000",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${LITEASY_ADMIN_REDIRECT_URI}"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "liteasy-admin-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "liteasy-admin",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "liteasy-admin-mfa-proof",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "liteasy_admin_mfa",
            "claim.value": "true",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "clientId": "liteasy-cloud",
      "name": "Liteasy cloud token introspection",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LITEASY_CLOUD_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "intuecho-api",
      "name": "Intuecho API token introspection",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${INTUECHO_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "liteasy-account-lifecycle",
      "name": "Liteasy account lifecycle caller",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LITEASY_IDENTITY_MANAGEMENT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "accounts:write", "sessions:revoke"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "identity-management-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "liteasy-identity-management",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "liteasy-identity-introspection",
      "name": "Identity-management token introspection",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LITEASY_IDENTITY_INTROSPECTION_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "intuecho-organization-service",
      "name": "Intuecho organization authorization service",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${INTUECHO_ORGANIZATION_SERVICE_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "organization:authorize"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "liteasy-internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "liteasy-internal",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "liteasy-visualization-service",
      "name": "Liteasy visualization generation service",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LITEASY_VISUALIZATION_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "visualization:generate"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "liteasy-visualization-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "liteasy-internal",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "liteasy-literature-projection-service",
      "name": "Liteasy literature projection service",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LITEASY_LITERATURE_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "literature:verify"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "intuecho-internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "intuecho-internal",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "liteasy-keycloak-admin",
      "name": "Liteasy Keycloak management adapter",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LITEASY_IDENTITY_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic"],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-liteasy-keycloak-admin",
      "enabled": true,
      "serviceAccountClientId": "liteasy-keycloak-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "query-users", "view-users"]
      }
    }
  ]
}
