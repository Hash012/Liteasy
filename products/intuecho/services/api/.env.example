NODE_ENV=production
INTUECHO_API_HOST=127.0.0.1
INTUECHO_API_PORT=4040
INTUECHO_ALLOWED_ORIGINS=https://forum.example.com

# The forum uses its own database and roles. These URLs must not point at the
# Liteasy cloud database or reuse its application/migration credentials.
INTUECHO_DATABASE_URL=postgresql://intuecho_app:replace-me@postgres.example.internal:5432/intuecho
INTUECHO_MIGRATION_DATABASE_URL=postgresql://intuecho_migrator:replace-me@postgres.example.internal:5432/intuecho
INTUECHO_DATABASE_SSL_MODE=verify-full

# Unified IdP, distinct confidential API and public PKCE Web clients.
INTUECHO_IDP_ISSUER=https://identity.example.com
INTUECHO_IDP_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
INTUECHO_IDP_JWKS_URL=https://identity.example.com/.well-known/jwks.json
INTUECHO_IDP_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
INTUECHO_IDP_TOKEN_URL=https://identity.example.com/oauth2/token
INTUECHO_IDP_CLIENT_ID=intuecho-api
INTUECHO_IDP_CLIENT_SECRET=replace-me
INTUECHO_IDP_WEB_CLIENT_ID=intuecho-web

# Dedicated client-credentials identity used only for Liteasy organization checks.
INTUECHO_ORGANIZATION_API_URL=https://api.example.com
INTUECHO_ORGANIZATION_SERVICE_CLIENT_ID=intuecho-organization-service
INTUECHO_ORGANIZATION_SERVICE_CLIENT_SECRET=replace-me

# The separate Liteasy administration API remains the source of truth for
# platform_admin grants. Intuecho forwards the liteasy-admin token to /v1/admin/me.
INTUECHO_ADMIN_API_URL=https://api.example.com

# Literature providers are queried only by the server. Keep optional provider keys
# out of browser and desktop configuration.
INTUECHO_ARXIV_ENDPOINT=https://export.arxiv.org/api/query
INTUECHO_CROSSREF_ENDPOINT=https://api.crossref.org/works
INTUECHO_OPENALEX_ENDPOINT=https://api.openalex.org/works
INTUECHO_OPENALEX_API_KEY=
INTUECHO_SEMANTIC_SCHOLAR_ENDPOINT=https://api.semanticscholar.org/graph/v1/paper
INTUECHO_SEMANTIC_SCHOLAR_API_KEY=
