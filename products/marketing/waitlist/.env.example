WAITLIST_DATA_DIR=/var/lib/liteasy/waitlist
WAITLIST_ALLOWED_ORIGINS=https://staging.liteasyclaw.com
WAITLIST_MAX_PER_HOUR=5
WAITLIST_APPLICATION_API_URL=https://api.staging.liteasyclaw.com
WAITLIST_APPLICATION_API_SECRET=replace-with-the-same-random-server-secret
WAITLIST_APPLICATION_API_TIMEOUT_MS=5000
WAITLIST_RELEASE_AUDIENCE=liteasy-staging-installer-upload
WAITLIST_RELEASE_REPOSITORY=Hash012/Liteasy
WAITLIST_RELEASE_VERSION=0.1.0
WAITLIST_RELEASE_WORKFLOW=.github/workflows/windows-installer.yml

# Enable download only after a reviewed, signed installer has been placed here.
WAITLIST_INSTALLER_PATH=/var/lib/liteasy/downloads/Liteasy_0.1.0_x64-setup.exe
WAITLIST_INSTALLER_NAME=Liteasy_0.1.0_x64-setup.exe
WAITLIST_DOWNLOAD_TTL_SECONDS=600
WAITLIST_DOWNLOAD_SECRET=replace-with-64-random-hex-characters
