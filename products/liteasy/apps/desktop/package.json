{
  "name": "liteasy-desktop",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-cloud.mjs --dev:cloud --dev:desktop",
    "dev:test-api": "node scripts/dev-with-cloud.mjs",
    "dev:cloud": "node ../../../../development/dev-cloud/server.mjs",
    "dev:cloud-and-desktop": "node scripts/dev-with-cloud.mjs",
    "dev:desktop": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run schema:visualization && tsc && vite build && node scripts/verify-production-assets.mjs",
    "preview": "vite preview",
    "schema:visualization": "vite-node scripts/write-visualization-artifact-schema.ts",
    "test": "vitest run",
    "verify:production-assets": "node scripts/verify-production-assets.mjs",
    "gate:retrieval-sample": "node scripts/retrieval-gate-sample.mjs",
    "gate:retrieval-report": "vitest run src/tests/retrievalGateWorksheet.test.ts",
    "label:multimodal-decisions": "node scripts/multimodal-decision-gate-label.mjs",
    "test:thin-reading-eval": "vitest run src/tests/thinReadingEvaluation.test.ts src/tests/thinReadingRealPdfGold.test.ts",
    "test:thin-reading-live-model": "node scripts/thin-reading-live-model-eval.mjs",
    "test:thin-reading-external-live": "node scripts/thin-reading-external-knowledge-live-eval.mjs",
    "test:thin-reading-ocr-offline": "node scripts/thin-reading-ocr-offline-eval.mjs",
    "test:thin-reading-openalex-live": "node scripts/thin-reading-openalex-live-eval.mjs",
    "benchmark:visualization": "vite-node scripts/benchmark-visualization-runtime.ts --fixtures ../../../../development/test-data/thin-reading-multimodal --dist dist",
    "record:multimodal-decisions": "vite-node scripts/record-multimodal-decision-evaluation.ts",
    "test:multimodal-release": "npm run build && vitest run src/tests/staticScienceConformance.test.ts src/tests/interactiveMathConformance.test.ts src/tests/processRasterConformance.test.ts src/tests/staticScienceReleaseGate.test.ts src/tests/interactiveMathReleaseGate.test.ts src/tests/processRasterReleaseGate.test.ts src/tests/multimodalEvaluation.test.ts src/tests/visualizationDecisionEvaluation.test.ts src/tests/visualizationPerformance.test.ts src/tests/multimodalReleaseGate.test.ts src/tests/builtinSkillRegistry.test.ts src/tests/visualizationRendererRegistry.test.ts && npm run benchmark:visualization",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.4",
    "@fluentui/react-icons": "^2.0.333",
    "@tauri-apps/api": "^2.5.0",
    "@xyflow/react": "^12.11.2",
    "chevrotain": "^11.2.0",
    "d3-force": "^3.0.0",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^6.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
