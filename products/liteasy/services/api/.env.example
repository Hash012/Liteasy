NODE_ENV=production
LITEASY_CLOUD_HOST=127.0.0.1
LITEASY_CLOUD_PORT=8787
LITEASY_ALLOWED_ORIGINS=http://tauri.localhost

# Use a deployment secret. Production requires TLS verification.
DATABASE_URL=postgresql://liteasy_app:replace-me@postgres.example.internal:5432/liteasy
# Used only by `npm run migrate`; must use a distinct, deployment-scoped role.
LITEASY_MIGRATION_DATABASE_URL=postgresql://liteasy_migrator:replace-me@postgres.example.internal:5432/liteasy
LITEASY_DATABASE_SSL_MODE=verify-full

LITEASY_S3_REGION=ap-southeast-1
LITEASY_S3_BUCKET=liteasy-private-documents
# Optional for an S3-compatible private endpoint. Production requires HTTPS.
LITEASY_S3_ENDPOINT=https://s3.example.internal
LITEASY_S3_FORCE_PATH_STYLE=false
LITEASY_S3_PREFIX=documents

# Required fail-closed PDF malware/content scanner. The cloud streams the private
# staging object to this HTTPS endpoint and requires a hash-bound clean result.
LITEASY_PDF_SCANNER_URL=https://pdf-scanner.example.internal/v1/pdf:scan
LITEASY_PDF_SCANNER_SECRET=replace-with-deployment-scanner-secret
LITEASY_PDF_SCANNER_TIMEOUT_MS=120000

# Unified identity service. The cloud verifies JWTs and checks revocation through RFC 7662.
LITEASY_IDP_ISSUER=https://identity.example.com
LITEASY_IDP_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
LITEASY_IDP_JWKS_URL=https://identity.example.com/.well-known/jwks.json
LITEASY_IDP_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
LITEASY_IDP_REVOCATION_URL=https://identity.example.com/oauth2/revoke
LITEASY_IDP_TOKEN_URL=https://identity.example.com/oauth2/token
LITEASY_IDP_CLIENT_ID=liteasy-cloud
LITEASY_IDP_CLIENT_SECRET=replace-me
LITEASY_IDP_DESKTOP_CLIENT_ID=liteasy-desktop-public
LITEASY_IDP_ADMIN_CLIENT_ID=liteasy-admin-public
# Dedicated Intuecho machine client. Its token must use audience liteasy-internal
# and the organization:authorize scope; it is never exposed to either browser.
LITEASY_IDP_INTUECHO_SERVICE_CLIENT_ID=intuecho-organization-service
# Dedicated least-privilege client for account disable/delete and global session revocation.
LITEASY_IDP_MANAGEMENT_CLIENT_ID=liteasy-account-lifecycle
LITEASY_IDP_MANAGEMENT_CLIENT_SECRET=replace-me
LITEASY_IDP_MANAGEMENT_URL=https://identity-admin.example.internal

# Intuecho re-verifies the forwarded liteasy-admin token and fresh MFA.
LITEASY_INTUECHO_ADMIN_API_URL=https://forum-api.example.internal

# Used only by the one-time `npm run bootstrap:admin` command. Keep these in the
# deployment secret/job definition, not the long-running service environment.
# LITEASY_BOOTSTRAP_ADMIN_SUBJECT=idp-subject
# LITEASY_BOOTSTRAP_REASON=Approved initial production administrator
# LITEASY_BOOTSTRAP_CONFIRM=bootstrap-first-platform-admin

# Optional real model providers. Supply each provider's three values together through
# the deployment secret store. The service fixes the upstream model server-side and
# returns an explicit 503 when the active policy selects an unconfigured provider.
# LITEASY_MODEL_OPENAI_API_KEY=replace-me
# LITEASY_MODEL_OPENAI_BASE_URL=https://api.openai.com/v1
# LITEASY_MODEL_OPENAI_MODEL=gpt-5-mini
# LITEASY_MODEL_DEEPSEEK_API_KEY=replace-me
# LITEASY_MODEL_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LITEASY_MODEL_DEEPSEEK_MODEL=deepseek-v4-flash
LITEASY_MODEL_TIMEOUT_MS=60000

# Visualization providers use route-owned secret references. The JSON map is
# deployment-owned and must contain only viz-secret references and externally
# managed values; no credential is stored in a database route or admin payload.
LITEASY_VISUALIZATION_EGRESS_HOSTNAMES=provider.example
# LITEASY_VISUALIZATION_SECRETS_JSON='{"viz-secret:provider-1":"<managed-by-deployment>"}'

# Crossref polite-pool contact. The service performs real retrieval and never returns fixture candidates.
LITEASY_RECOMMENDATION_CONTACT_EMAIL=operations@example.com
LITEASY_RECOMMENDATION_CROSSREF_ENDPOINT=https://api.crossref.org/works
LITEASY_RECOMMENDATION_TIMEOUT_MS=10000

# Server-side scholarly retrieval. Crossref, OpenAlex, and Semantic Scholar
# endpoints are fixed connector contracts selected in the administrator UI.
LITEASY_RETRIEVAL_CONTACT_EMAIL=operations@example.com
LITEASY_RETRIEVAL_TIMEOUT_MS=15000
LITEASY_RETRIEVAL_MAX_PDF_BYTES=33554432
# Optional deployment secret for higher Semantic Scholar rate limits.
# LITEASY_RETRIEVAL_SEMANTIC_SCHOLAR_API_KEY=replace-me

# S3 credentials use the AWS SDK provider chain. Do not commit any credential here.
