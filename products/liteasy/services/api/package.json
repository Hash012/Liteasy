    "@tesseract.js-data/eng": "1.0.0",
    "ajv": "^8.17.1",
    "jose": "^6.2.8",
    "pg": "^8.16.3",
    "tesseract.js": "6.0.1"
  },
  "engines": {
    "node": ">=20"
  }
