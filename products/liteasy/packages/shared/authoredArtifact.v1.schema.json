{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "liteasy.authored-artifact/v1"
        },
        "kind": {
          "type": "string",
          "const": "slides"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "slides": {
          "minItems": 1,
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "markdown": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "notes": {
                "type": "string",
                "maxLength": 4000
              },
              "evidenceIds": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "required": [
              "id",
              "title",
              "markdown",
              "notes",
              "evidenceIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "kind",
        "title",
        "slides"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "liteasy.authored-artifact/v1"
        },
        "kind": {
          "type": "string",
          "const": "outline"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "nodes": {
          "minItems": 1,
          "maxItems": 1200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "parentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evidenceIds": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "required": [
              "id",
              "parentId",
              "label",
              "evidenceIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "kind",
        "title",
        "nodes"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://schemas.liteasy.app/authoredArtifact.v1.schema.json"
}
