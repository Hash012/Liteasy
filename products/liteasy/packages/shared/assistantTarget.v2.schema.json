          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "conversationId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "workflow_task"
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "taskId"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://schemas.liteasy.app/assistantTarget.v2.schema.json"
}
