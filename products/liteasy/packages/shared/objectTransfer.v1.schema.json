{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "liteasy.object-transfer/v1"
    },
    "transferId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "refs": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "selectorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "objectId",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "text": {
      "type": "string",
      "maxLength": 100000
    },
    "mode": {
      "type": "string",
      "enum": [
        "reference",
        "copy"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "transferId",
    "refs",
    "mode"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.liteasy.app/objectTransfer.v1.schema.json"
}
