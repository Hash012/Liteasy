{
  "abiVersion": "liteasy.workflow-skill/v1",
  "description": "在明确数据、负载、指标和资源条件后比较论文或方案，不制造脱离条件的排名。",
  "id": "research-compare",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "requestId": {
        "type": "string"
      }
    },
    "required": [
      "requestId"
    ],
    "type": "object"
  },
  "name": "条件化比较",
  "output": {
    "source": "step",
    "stepId": "generate"
  },
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "artifactId": {
        "type": "string"
      },
      "resourceUri": {
        "type": "string"
      },
      "message": {
        "type": "string"
      }
    },
    "required": [
      "artifactId",
      "resourceUri",
      "message"
    ],
    "type": "object"
  },
  "permissions": [
    "model.invoke",
    "context.read",
    "artifact.write"
  ],
  "steps": [
    {
      "id": "generate",
      "input": {
        "requestId": {
          "source": "input",
          "path": "requestId"
        }
      },
      "operator": {
        "id": "liteasy.research.generate-document",
        "version": "1.0.0"
      }
    }
  ],
  "version": "0.1.0"
